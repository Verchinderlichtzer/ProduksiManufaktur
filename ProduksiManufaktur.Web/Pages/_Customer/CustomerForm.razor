@inherits CustomerFormBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="h-375">
            <MudForm Model="Customer" @ref="form" Validation="@(validator.ValidateValue)">
                <MudTextField T="string" OnlyValidateIfDirty="true" MaxLength="50" Immediate="true" For="(() => Customer.Nama)" Label="Nama Customer" @bind-Value="Customer.Nama" AutoFocus="true" />
                <MudTextField T="string" MaxLength="150" Label="Alamat" @bind-Value="Customer.Alamat" />
                <MudTextField T="string" MaxLength="24" For="(() => Customer.Telepon)" Label="Telepon" @bind-Value="Customer.Telepon" />
                <MudTextField T="string" MaxLength="24" For="(() => Customer.Fax)" Label="Fax" @bind-Value="Customer.Fax" />
                <MudTextField T="string" MaxLength="60" For="(() => Customer.Email)" Label="Email" @bind-Value="Customer.Email" InputType="InputType.Email" />
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div>
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Help" @onmouseenter="@(() => popupTerbuka = true)" @onmouseleave="@(() => popupTerbuka = false)" />
            <MudPopover Open="@popupTerbuka" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomLeft" Fixed="true" Class="px-4">
                <MudStack Spacing="0" Class="pb-2">
                    <MudText Typo="Typo.button" Class="pt-2">Nama :</MudText>
                    <div>▪ Tidak boleh kosong</div>
                    <MudText Typo="Typo.button" Class="pt-2">Telepon :</MudText>
                    <div>▪ Tidak boleh sama dengan yang lain</div>
                    <MudText Typo="Typo.button" Class="pt-2">Fax :</MudText>
                    <div>▪ Tidak boleh sama dengan yang lain</div>
                    <MudText Typo="Typo.button" Class="pt-2">Email :</MudText>
                    <div>▪ Tidak boleh sama dengan yang lain</div>
                </MudStack>
            </MudPopover>
        </div>
        @if (result is null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">Terjadi kesalahan saat menyimpan data, harap periksa kembali dan refresh form.</MudText>
        }
        <MudSpacer />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null)">Simpan</MudButton>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => Cancel())">Batal</MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@if (!string.IsNullOrEmpty(Customer.Nama) || !string.IsNullOrEmpty(Customer.Alamat) || !string.IsNullOrEmpty(Customer.Telepon) || !string.IsNullOrEmpty(Customer.Fax) || !string.IsNullOrEmpty(Customer.Email))
{
    <NavigationLock ConfirmExternalNavigation="true" />
}