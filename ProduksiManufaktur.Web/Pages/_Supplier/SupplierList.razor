@page "/supplier"
@inherits SupplierListBase

<PageTitle>Supplier - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudDataGrid Items="listSupplier" Elevation="2" Dense="true" Bordered="true" QuickFilter="FilterSearch" ShowColumnOptions="false">
        <ToolBarContent>
            <MudStack Row="true" Spacing="2">
                <MudText Typo="Typo.h5">Daftar Supplier</MudText>
                <AuthorizeView Policy="PihakWrite">
                    <Authorized Context="konteks">
                        <MudTooltip Text="Tambah Supplier" Arrow="true" Placement="Placement.Bottom">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(async e => await Form())" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudSpacer />
            <MudTextField Immediate="true" @bind-Value="dicari" Placeholder="Cari supplier..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <Column T="Supplier" Field="Id" Title="ID" HeaderStyle="width:1px" />
            <Column T="Supplier" Field="Nama" />
            <Column T="Supplier" Field="Alamat" />
            <Column T="Supplier" Field="Telepon" HeaderStyle="width:125px" />
            <Column T="Supplier" Field="Fax" HeaderStyle="width:125px" />
            <Column T="Supplier" Field="Email" HeaderStyle="width:1px" />
            <AuthorizeView Policy="PihakWrite">
                <Authorized Context="konteks">
                    <Column T="Supplier" HeaderStyle="width:1px" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(async e => await Form(context.Item))" />
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(async e => await Hapus(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </Column>
                </Authorized>
            </AuthorizeView>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Supplier" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} supplier" />
        </PagerContent>
    </MudDataGrid>
}

<MudMessageBox @ref="deleteDialog" Title="Konfirmasi Hapus">
    <MessageContent>
        <MudPaper Elevation="0" MinWidth="300px" Class="mx-5">
            @pesanHapus
        </MudPaper>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Error" Size="Size.Small">Ya</MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Dark" Size="Size.Small">Tidak</MudButton>
    </YesButton>
</MudMessageBox>