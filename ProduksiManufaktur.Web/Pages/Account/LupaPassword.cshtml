@page
@model ProduksiManufaktur.Web.Pages.Account.LupaPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Title = "Lupa Password";
    Layout = "_Layout";
}

<div class="container">
    <form method="post">
        <input asp-for="Input.Email" class="" placeholder="Email" required autofocus />
        <span asp-validation-for="Input.Email" class="validation-message"> </span>
        <button type="submit">Kirim</button>
    </form>
</div>
<div id="form-footer">
    <a href="/Account/Login">Login</a>
</div>