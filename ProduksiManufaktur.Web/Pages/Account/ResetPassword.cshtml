@page
@model ProduksiManufaktur.Web.Pages.Account.ResetPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Title = "Reset Password";
    Layout = "_Layout";
}


<div class="container">
    <form method="post">
        <input asp-for="Input.Token" type="hidden" />
        <input asp-for="Input.Email" type="hidden" />
        <div class="form-group">
            <input asp-for="Input.Password" placeholder="Password Baru" />
            <span asp-validation-for="Input.Password" class="validation-message"> </span>
        </div>
        <div class="form-group">
            <input asp-for="Input.KonfirmasiPassword" placeholder="Konfirmasi Password" />
            <span asp-validation-for="Input.KonfirmasiPassword" class="validation-message"> </span>
        </div>
        <button type="submit">Reset</button>
    </form>
</div>
<div id="form-footer">
    <a href="/Account/Login">Login</a>
</div>