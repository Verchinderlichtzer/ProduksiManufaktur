@page
@model ProduksiManufaktur.Web.Pages.Account.GantiPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.Title = "Ganti Password";
    Layout = "_Layout";
}


<div class="container" style="height: 260px;">
    <form method="post">
        @*<input asp-for="Input.Id" type="hidden" />*@
        <div class="form-group">
            <input asp-for="Input.PasswordLama" placeholder="Password Lama" />
            <span asp-validation-for="Input.PasswordLama" class="validation-message"> </span>
        </div>
        <div class="form-group">
            <input asp-for="Input.PasswordBaru" placeholder="Password Baru" />
            <span asp-validation-for="Input.PasswordBaru" class="validation-message"> </span>
        </div>
        <div class="form-group">
            <input asp-for="Input.KonfirmasiPasswordBaru" placeholder="Konfirmasi Password Baru" />
            <span asp-validation-for="Input.KonfirmasiPasswordBaru" class="validation-message"> </span>
        </div>
        <button type="submit">Ubah</button>
    </form>
</div>