@page "/formulasi/form"
@page "/formulasi/form/{id}"
@inherits FormulasiFormBase

<PageTitle>Form Formulasi - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudPaper Elevation="0" Class="mt-3 pa-4">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>
        <MudForm Model="formulasi" @ref="form" Validation="@(validator.ValidateValue)">
            <MudStack Row="true">
                <div class="flex-9">
                    <MudAutocomplete T="Barang" OnlyValidateIfDirty="true" Immediate="true" For="(() => formulasi.Barang)" Dense="true" Label="Barang" CoerceText="true" Value="formulasi.Barang" ValueChanged="@(e => PilihBarang(e))" SearchFunc="@(async e => await CariBarang(e))" ToStringFunc="@(x => x is null ? null : x.Nama)" MaxItems="80" />
                </div>
                <div class="flex-2">
                    <MudNumericField T="decimal" Value="formulasi.Jumlah" ValueChanged="@(e => formulasi.Jumlah = decimal.Round(e, 2))" Label="Jumlah Barang" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="@formulasi.Barang?.SatuanProduksi" Min="0.01m" Max="1000000" Format="g0" />
                </div>
            </MudStack>
        </MudForm>
        <MudPaper Elevation="0" Class="mt-3">
            <MudStack Row="true" Class="my-3">
                <MudText Typo="Typo.h6">Bahan yang dibutuhkan :</MudText>
                <MudSpacer />
                <MudAutocomplete Class="mt-n3" T="Bahan" @ref="inputBahan" Dense="true" Placeholder="Cari bahan..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" CoerceText="true" SearchFunc="@(async e => await CariBahan(e))" ValueChanged="@(e => PilihBahan(e))" ToStringFunc="@(x => x is null ? null : x.Nama)" MaxItems="80" />
            </MudStack>
            <div class="grid-container">
                @foreach (var detail in formulasi.FormulasiDetail!)
                {
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.button">@detail.Bahan!.Nama</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudDivider />
                        <MudCardContent>
                            <MudNumericField T="decimal" Value="detail.Jumlah" ValueChanged="@(e => detail.Jumlah = decimal.Round(e, 2))" Label="Jumlah" Immediate="true" HideSpinButtons="true" Format="g0" Adornment="Adornment.End" AdornmentText="@($"/ {detail.Bahan!.SatuanProduksi}")" Min="0.01m" Max="1000000" />
                        </MudCardContent>
                        <MudCardActions Class="d-flex flex-row-reverse">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(e => Delete(detail))" tabindex="-1" />
                        </MudCardActions>
                    </MudCard>
                }
            </div>
        </MudPaper>
        <MudStack Row="true" Class="mt-4">
            <div>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Help" @onmouseenter="@(() => popupTerbuka = true)" @onmouseleave="@(() => popupTerbuka = false)" />
                <MudPopover Open="@popupTerbuka" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomLeft" Fixed="true" Class="px-4">
                    <MudStack Spacing="0" Class="pb-2">
                        <MudText Typo="Typo.button" Class="pt-2">Barang :</MudText>
                        <div>▪ Tidak boleh kosong</div>
                        <MudText Typo="Typo.button" Class="pt-2">Jumlah :</MudText>
                        <div>▪ Tidak boleh kosong</div>
                        <div>▪ Tidak boleh melebihi 1Jt</div>
                    </MudStack>
                </MudPopover>
            </div>
            @if (result is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">@pesan</MudText>
            }
            <MudSpacer />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null || !formulasi.FormulasiDetail!.Any())">Simpan</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => To.NavigateTo("/formulasi"))">Batal</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (baru && (formulasi.Barang is not null || formulasi.Jumlah > 0 || formulasi.FormulasiDetail!.Any()))
{
    <NavigationLock ConfirmExternalNavigation="true" />
}