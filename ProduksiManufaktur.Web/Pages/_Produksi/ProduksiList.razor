@page "/produksi"
@inherits ProduksiListBase

<PageTitle>Produksi - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudDataGrid Items="listProduksi" Elevation="2" Dense="true" Bordered="true" QuickFilter="FilterSearch" ShowColumnOptions="false">
        <ToolBarContent>
            <MudStack Row="true" Spacing="2">
                <MudText Typo="Typo.h5">Daftar Produksi</MudText>
                <AuthorizeView Policy="ProduksiWrite">
                    <Authorized Context="konteks">
                        <MudTooltip Text="Tambah Produksi" Arrow="true" Placement="Placement.Bottom">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(e => To.NavigateTo($"/produksi/form"))" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudSpacer />
            <MudTextField Immediate="true" @bind-Value="dicari" Placeholder="Cari produksi..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <Column T="Produksi" Field="Id" Title="ID" HeaderStyle="width:133px" />
            <Column T="Produksi" Field="Tanggal" HeaderStyle="width:145px">
                <CellTemplate>
                    @context.Item.Tanggal.ToString("dd/MM/yyyy HH.mm")
                </CellTemplate>
            </Column>
            <Column T="Produksi" Field="Barang" Title="Nama Barang" SortBy="@(e => e.Barang!.Nama)">
                <CellTemplate>
                    @context.Item.Barang!.Nama
                </CellTemplate>
            </Column>
            <Column T="Produksi" Field="Jumlah" HeaderStyle="width:140px" CellStyle="text-align:center">
                <CellTemplate>
                    @context.Item.Jumlah.ToString("g0") @context.Item.Barang!.SatuanProduksi
                </CellTemplate>
            </Column>
            <Column T="Produksi" Field="Total" Title="Biaya Produksi" HeaderStyle="width:1px" CellStyle="text-align:right">
                <CellTemplate>
                    @context.Item.Total.ToString("n0")
                </CellTemplate>
            </Column>
            <Column T="Produksi" HeaderStyle="width:1px" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Info" Color="Color.Info" OnClick="@(e => To.NavigateTo($"/produksi/info/{context.Item.Id}"))" />
                        <AuthorizeView Roles="Admin">
                            <Authorized Context="konteks">
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(e => To.NavigateTo($"/produksi/form/{context.Item.Id}"))" />
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(e => Hapus(context.Item))" />
                            </Authorized>
                        </AuthorizeView>
                    </MudStack>
                </CellTemplate>
            </Column>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Produksi" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} produksi" />
        </PagerContent>
    </MudDataGrid>
}

<MudMessageBox @ref="deleteDialog" Title="Konfirmasi Hapus">
    <MessageContent>
        <MudPaper Elevation="0" MinWidth="300px" Class="mx-5">
            @pesanHapus
        </MudPaper>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Error" Size="Size.Small">Ya</MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Dark" Size="Size.Small">Tidak</MudButton>
    </YesButton>
</MudMessageBox>