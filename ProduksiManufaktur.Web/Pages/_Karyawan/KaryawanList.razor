@page "/karyawan"
@inherits KaryawanListBase

<PageTitle>Karyawan - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudDataGrid Items="listKaryawan" Elevation="2" Dense="true" Bordered="true" QuickFilter="FilterSearch" ShowColumnOptions="false">
        <ToolBarContent>
            <MudStack Row="true" Spacing="2">
                <MudText Typo="Typo.h5">Daftar Karyawan</MudText>
                <AuthorizeView Policy="PekerjaWrite">
                    <Authorized Context="konteks">
                        <MudTooltip Text="Tambah Karyawan" Arrow="true" Placement="Placement.Bottom">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(async e => await Form())" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudSpacer />
            <MudTextField Immediate="true" @bind-Value="dicari" Placeholder="Cari karyawan..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="Karyawan" IconSize="Size.Small" />
            <Column T="Karyawan" Field="Id" Title="ID" HeaderStyle="width:1px" />
            <Column T="Karyawan" Field="Nama" />
            <Column T="Karyawan" Field="Telepon" HeaderStyle="width:1px" />
            <Column T="Karyawan" Field="Email" HeaderStyle="width:1px" />
            <AuthorizeView Policy="PekerjaWrite">
                <Authorized Context="konteks">
                    <Column T="Karyawan" HeaderStyle="width:1px" Sortable="false">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(e => Form(context.Item))" />
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(e => Hapus(context.Item))" />
                            </MudStack>
                        </CellTemplate>
                    </Column>
                </Authorized>
            </AuthorizeView>
        </Columns>
        <ChildRowContent>
            <MudContainer Class="my-4">
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="0">
                        <div class="w-125">
                            <MudText Typo="Typo.body1">Alamat</MudText>
                        </div>
                        <div class="flex-1">
                            <MudText Typo="Typo.body1">: @context.Item.Alamat</MudText>
                        </div>
                    </MudStack>
                    <MudStack Row="true" Spacing="0">
                        <div class="w-125">
                            <MudText Typo="Typo.body1">Tempat Lahir</MudText>
                        </div>
                        <div class="flex-1">
                            <MudText Typo="Typo.body1">: @context.Item.TempatLahir</MudText>
                        </div>
                    </MudStack>
                    <MudStack Row="true" Spacing="0">
                        <div class="w-125">
                            <MudText Typo="Typo.body1">Tanggal Lahir</MudText>
                        </div>
                        <div class="flex-1">
                            <MudText Typo="Typo.body1">: @context.Item.TanggalLahir.ToString("dd/MM/yyyy")</MudText>
                        </div>
                    </MudStack>
                    <MudStack Row="true" Spacing="0">
                        <div class="w-125">
                            <MudText Typo="Typo.body1">Pekerjaan</MudText>
                        </div>
                        <div class="flex-1">
                            <MudText Typo="Typo.body1">: @context.Item.Pekerjaan!.Nama</MudText>
                        </div>
                    </MudStack>
                    <MudStack Row="true" Spacing="0">
                        <div class="w-125">
                            <MudText Typo="Typo.body1">Upah</MudText>
                        </div>
                        <div class="flex-1">
                            <MudText Typo="Typo.body1">: @context.Item.Upah.ToString("c0")</MudText>
                        </div>
                    </MudStack>
                </MudStack>
            </MudContainer>
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="Karyawan" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} karyawan" />
        </PagerContent>
    </MudDataGrid>
}

<MudMessageBox @ref="deleteDialog" Title="Konfirmasi Hapus">
    <MessageContent>
        <MudPaper Elevation="0" MinWidth="300px" Class="mx-5">
            @pesanHapus
        </MudPaper>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Error" Size="Size.Small">Ya</MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Dark" Size="Size.Small">Tidak</MudButton>
    </YesButton>
</MudMessageBox>