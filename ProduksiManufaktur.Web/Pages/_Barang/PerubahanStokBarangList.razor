@page "/barang/perubahan-stok-barang"
@inherits PerubahanStokBarangListBase

<PageTitle>Perubahan Stok Barang - Produksi Manufaktur</PageTitle>
@if (listPerubahanStokBarang is null)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudDataGrid Items="listPerubahanStokBarang" Elevation="2" Dense="true" Bordered="true" QuickFilter="FilterSearch" ShowColumnOptions="false">
        <ToolBarContent>
            <MudStack Row="true" Spacing="2">
                <MudText Typo="Typo.h5">Daftar Perubahan Stok Barang</MudText>
                <AuthorizeView Policy="ProdukWrite">
                    <Authorized Context="konteks">
                        <MudTooltip Text="Tambah Perubahan Stok Barang" Arrow="true" Placement="Placement.Bottom">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(async e => await Form())" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudSpacer />
            <MudTextField Immediate="true" @bind-Value="dicari" Placeholder="Cari perubahan stok barang..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <Column T="PerubahanStokBarang" Field="Id" Title="ID" HeaderStyle="width:1px" />
            <Column T="PerubahanStokBarang" Field="Tanggal" HeaderStyle="width:145px" CellStyle="text-align:center">
                <CellTemplate>
                    @context.Item.Tanggal.ToString("dd/MM/yyyy HH.mm")
                </CellTemplate>
            </Column>
            <Column T="PerubahanStokBarang" Field="Barang" Title="Nama Barang" HeaderStyle="width:240px" CellStyle="text-align:center" SortBy="@(e => e.Barang!.Nama)">
                <CellTemplate>
                    @context.Item.Barang!.Nama
                </CellTemplate>
            </Column>
            <Column T="PerubahanStokBarang" Field="Jumlah" HeaderStyle="width:1px" CellStyle="text-align:center">
                <CellTemplate>
                    @context.Item.Jumlah.ToString("g0")
                </CellTemplate>
            </Column>
            <Column T="PerubahanStokBarang" Field="Jenis" HeaderStyle="width:1px" CellStyle="text-align:center">
                <CellTemplate>
                    <MudText Color="@(context.Item.Jenis == "Penambahan" ? Color.Success : Color.Error)">
                        @context.Item.Jenis
                    </MudText>
                </CellTemplate>
            </Column>
            <Column T="PerubahanStokBarang" Field="Keterangan" CellStyle="text-align:center" />
            <Column T="PerubahanStokBarang" HeaderStyle="width:1px" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(e => Form(context.Item))" />
                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(e => Hapus(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </Column>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="PerubahanStokBarang" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} perubahan stok" />
        </PagerContent>
    </MudDataGrid>
}

<MudMessageBox @ref="deleteDialog" Title="Konfirmasi Hapus">
    <MessageContent>
        <MudPaper Elevation="0" MinWidth="300px" Class="mx-5">
            @pesanHapus
        </MudPaper>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Error" Size="Size.Small">Ya</MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Dark" Size="Size.Small">Tidak</MudButton>
    </YesButton>
</MudMessageBox>