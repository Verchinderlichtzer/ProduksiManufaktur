@inherits PekerjaanFormBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="h-375">
            <MudForm Model="Pekerjaan" @ref="form" Validation="@(validator.ValidateValue)">
                <MudTextField T="string" MaxLength="50" For="(() => Pekerjaan.Nama)" Label="Nama Pekerjaan" @bind-Value="Pekerjaan.Nama" AutoFocus="true" />
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div>
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Help" @onmouseenter="@(() => popupTerbuka = true)" @onmouseleave="@(() => popupTerbuka = false)" />
            <MudPopover Open="@popupTerbuka" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomLeft" Fixed="true" Class="px-4">
                <MudStack Spacing="0" Class="pb-2">
                    <MudText Typo="Typo.button" Class="pt-2">Nama :</MudText>
                    <div>▪ Tidak boleh kosong</div>
                    <div>▪ Tidak boleh sama dengan yang lain</div>
                </MudStack>
            </MudPopover>
        </div>
        @if (result is null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">Terjadi kesalahan saat menyimpan data, harap periksa kembali dan refresh form.</MudText>
        }
        <MudSpacer />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null)">Simpan</MudButton>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => Cancel())">Batal</MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@if (!string.IsNullOrEmpty(Pekerjaan.Nama))
{
    <NavigationLock ConfirmExternalNavigation="true" />
}