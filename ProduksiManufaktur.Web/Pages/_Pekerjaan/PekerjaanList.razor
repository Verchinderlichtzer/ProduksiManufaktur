@page "/pekerjaan"
@inherits PekerjaanListBase

<PageTitle>Pekerjaan - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudDataGrid Items="listPekerjaan" Elevation="2" Dense="true" Bordered="true" QuickFilter="FilterSearch" ShowColumnOptions="false">
        <ToolBarContent>
            <MudStack Row="true" Spacing="2">
                <MudText Typo="Typo.h5">Daftar Pekerjaan</MudText>
                <AuthorizeView Policy="PekerjaWrite">
                    <Authorized Context="konteks">
                        <MudTooltip Text="Tambah Pekerjaan" Arrow="true" Placement="Placement.Bottom">
                            <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(async e => await Form())" />
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>
            </MudStack>
            <MudSpacer />
            <MudTextField Immediate="true" @bind-Value="dicari" Placeholder="Cari pekerjaan..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            <Column T="Pekerjaan" Field="Id" Title="ID" HeaderStyle="width:1px" />
            <Column T="Pekerjaan" Field="Nama" />
            <Column T="Pekerjaan" Field="JumlahKaryawan" Title="Jumlah Karyawan" HeaderStyle="width:1px" CellStyle="text-align:center" />
            <Column T="Pekerjaan" HeaderStyle="width:1px" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Info" Color="Color.Info" OnClick="@(e => To.NavigateTo($"/pekerjaan/info/{context.Item.Id}"))" />
                        <AuthorizeView Policy="PekerjaWrite">
                            <Authorized Context="konteks">
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" OnClick="@(async e => await Form(context.Item))" />
                                <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(async e => await Hapus(context.Item))" />
                            </Authorized>
                        </AuthorizeView>
                    </MudStack>
                </CellTemplate>
            </Column>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Pekerjaan" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} pekerjaan" />
        </PagerContent>
    </MudDataGrid>
}

<MudMessageBox @ref="deleteDialog" Title="Konfirmasi Hapus">
    <MessageContent>
        <MudPaper Elevation="0" MinWidth="300px" Class="mx-5">
            @pesanHapus
        </MudPaper>
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Error" Size="Size.Small">Ya</MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled" Class="ma-1" Color="Color.Dark" Size="Size.Small">Tidak</MudButton>
    </YesButton>
</MudMessageBox>