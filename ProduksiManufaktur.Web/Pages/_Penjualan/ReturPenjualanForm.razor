@page "/penjualan/retur/form"
@page "/penjualan/retur/form/{id}"
@inherits ReturPenjualanFormBase

<PageTitle>Form Retur Penjualan - Produksi Manufaktur</PageTitle>
@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudPaper Elevation="0" Class="mt-3 pa-4">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>
        <MudForm Model="returPenjualan" @ref="form" Validation="@(validator.ValidateValue)">
            <div class="w-150">
                <MudAutocomplete T="Penjualan" For="(() => returPenjualan.Penjualan)" Dense="true" Label="Penjualan" Value="returPenjualan.Penjualan" ValueChanged="@(async e => await PilihPenjualan(e))" OnlyValidateIfDirty="true" Immediate="true" CoerceText="true" ReadOnly="@(!baru)" SearchFunc="@(async e => await CariPenjualan(e))" AutoFocus="true" ToStringFunc="@(x => x is null ? null : x.Id)" MaxItems="80" />
            </div>
            <MudStack Row="true">
                <MudStack Row="true" Class="w-250">
                    <div class="flex-5">
                        <MudDatePicker PickerVariant="PickerVariant.Dialog" @bind-Date="returPenjualan.InputTanggal" Label="Tanggal" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="flex-3">
                        <MudTimePicker PickerVariant="PickerVariant.Dialog" @bind-Time="returPenjualan.InputWaktu" Label="Waktu" />
                    </div>
                </MudStack>
                <MudSpacer />
                <div class="w-150">
                    <MudNumericField T="int" Label="Grand Total" ReadOnly="true" tabindex="-1" Value="returPenjualan.GrandTotal" HideSpinButtons="true" Format="n0" Adornment="Adornment.Start" AdornmentText="Rp" />
                </div>
            </MudStack>
            <MudTextField T="string" MaxLength="200" Label="Keterangan" @bind-Value="returPenjualan.Keterangan" />
        </MudForm>
        <MudPaper Elevation="0" Class="mt-3">
            @if (!string.IsNullOrEmpty(returPenjualan.PenjualanId))
            {
                <MudDataGrid Items="returPenjualan.ReturPenjualanDetail" Class="mt-3" Elevation="2" Dense="true" Bordered="true" ShowColumnOptions="false">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Barang yang dikembalikan</MudText>
                    </ToolBarContent>
                    <Columns>
                        <Column T="ReturPenjualanDetail" Field="BarangSatuan" Title="Nama Barang">
                            <CellTemplate>
                                @context.Item.BarangSatuan!.Barang!.Nama
                            </CellTemplate>
                        </Column>
                        <Column T="ReturPenjualanDetail" Field="Harga" HeaderStyle="width:110px" CellStyle="text-align:right">
                            <CellTemplate>
                                @context.Item.Harga.ToString("n0")
                            </CellTemplate>
                        </Column>
                        <Column T="ReturPenjualanDetail" Field="Jumlah" HeaderStyle="width:225px">
                            <CellTemplate>
                                <MudNumericField T="decimal" Class="mt-n1" Immediate="true" Value="context.Item.Jumlah" Adornment="Adornment.End" AdornmentText="@($"/ {context.Item.MaxJumlah:g0} {(string.IsNullOrEmpty(context.Item.BarangSatuan!.Ukuran) ? context.Item.BarangSatuan!.Nama : $"{context.Item.BarangSatuan!.Nama} ({context.Item.BarangSatuan!.Ukuran})")}")" ValueChanged="@(e => {context.Item.Jumlah = decimal.Round(e, 2); Hitung(); context.Item.Total = (int)(e * context.Item.Harga);})" Min="0" Max="@context.Item.MaxJumlah" HideSpinButtons="true" Format="g0" />
                            </CellTemplate>
                        </Column>
                        <Column T="ReturPenjualanDetail" Field="Total" HeaderStyle="width:130px" CellStyle="text-align:right">
                            <CellTemplate>
                                @context.Item.Total.ToString("n0")
                            </CellTemplate>
                        </Column>
                    </Columns>
                </MudDataGrid>
            }
        </MudPaper>
        <MudStack Row="true" Class="mt-4">
            <div>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Help" @onmouseenter="@(() => popupTerbuka = true)" @onmouseleave="@(() => popupTerbuka = false)" />
                <MudPopover Open="@popupTerbuka" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomLeft" Fixed="true" Class="px-4">
                    <MudStack Spacing="0" Class="pb-2">
                        <MudText Typo="Typo.button" Class="pt-2">Penjualan :</MudText>
                        <div>▪ Tidak boleh kosong</div>
                        <MudText Typo="Typo.button" Class="pt-2">Barang :</MudText>
                        <div>▪ Jumlah barang tidak boleh kosong semua</div>
                        <div>▪ Jumlah barang tidak boleh melebihi jumlah jual</div>
                    </MudStack>
                </MudPopover>
            </div>
            @if (result is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">@pesan</MudText>
            }
            <MudSpacer />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null || returPenjualan.ReturPenjualanDetail?.All(x => x.Jumlah == 0) == true)">Simpan</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => To.NavigateTo("/penjualan/retur"))">Batal</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (!string.IsNullOrEmpty(returPenjualan.PenjualanId) || !string.IsNullOrEmpty(returPenjualan.Keterangan) || returPenjualan.GrandTotal > 0)
{
    <NavigationLock ConfirmExternalNavigation="true" />
}