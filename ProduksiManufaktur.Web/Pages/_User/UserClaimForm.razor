@inherits UserClaimFormBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Class="h-375">
            <MudStack>
                <MudText Class="mt-3" Typo="Typo.h6">Hak Akses Form Master</MudText>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudStack Class="flex-1" Spacing="0">
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Akun"])" Label="Role, User" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Pekerja"])" Label="Pekerjaan, Karyawan" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Overhead"])" Label="Overhead" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                    <MudStack Class="flex-1" Spacing="0">
                            <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Produk"])" Label="Bahan, Barang, Formulasi" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Pihak"])" Label="Supplier, Customer" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudStack>
                <MudText Class="mt-3" Typo="Typo.h6">Hak Akses Form Transaksi</MudText>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudStack Class="flex-1" Spacing="0">
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Pembelian"])" Label="Pembelian" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Produksi"])" Label="Produksi" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                    <MudStack Class="flex-1" Spacing="0">
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Penjualan"])" Label="Penjualan" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["TransaksiLain"])" Label="Transaksi Lain" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                            <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                            <MudSelectItem Value="@("S1")">@("Read Only")</MudSelectItem>
                            <MudSelectItem Value="@("S2")">@("Read & Write")</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudStack>
                <MudText Class="mt-3" Typo="Typo.h6">Hak Akses Form Laporan</MudText>
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudSelect T="string" Dense="true" @bind-Value="@(userClaim["Report"])" Label="Laporan" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("None")">@("None")</MudSelectItem>
                        <MudSelectItem Value="@("S0")">@("No Access")</MudSelectItem>
                        <MudSelectItem Value="@("S1")">@("Read")</MudSelectItem>
                    </MudSelect>
                </MudStack>
            </MudStack>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        @if (result is null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">Terjadi kesalahan saat menyimpan data, harap periksa kembali dan refresh form.</MudText>
        }
        <MudSpacer />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null)">Simpan</MudButton>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => Cancel())">Batal</MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

<NavigationLock ConfirmExternalNavigation="true" />