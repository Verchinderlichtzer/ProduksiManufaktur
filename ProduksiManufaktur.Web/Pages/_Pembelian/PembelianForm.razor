@page "/pembelian/form"
@page "/pembelian/form/{id}"
@inherits PembelianFormBase

@if (loaded is false)
{
    <MudProgressCircular Indeterminate="true" Class="spinner" />
}
else
{
    <MudPaper Elevation="0" Class="mt-3 pa-4">
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@icon" Class="mr-3 mb-n1" />
            @judul
        </MudText>

        <MudForm Model="pembelian" @ref="form" Validation="@(validator.ValidateValue)">
            <MudStack Row="true">
                <div class="flex-5">
                    <MudStack Row="true" Class="w-250">
                        <div class="flex-5">
                            <MudDatePicker PickerVariant="PickerVariant.Dialog" Date="pembelian.InputTanggal" DateChanged="@(e => {pembelian.InputTanggal = e; pembelian.JatuhTempo = e?.AddDays(1);})" Label="Tanggal" DateFormat="dd/MM/yyyy" Disabled="!baru" />
                        </div>
                        <div class="flex-3">
                            <MudTimePicker PickerVariant="PickerVariant.Dialog" @bind-Time="pembelian.InputWaktu" Label="Waktu" Disabled="!baru" />
                        </div>
                    </MudStack>
                    <div class="wp-50">
                        <MudAutocomplete T="Supplier" OnlyValidateIfDirty="true" Dense="true" Immediate="true" For="(() => pembelian.Supplier)" Label="Supplier" CoerceText="true" Value="pembelian.Supplier" ValueChanged="@(e => {pembelian.Supplier = e; pembelian.SupplierId = e.Id;})" SearchFunc="@(async e => await CariSupplier(e))" ToStringFunc="@(x => x is null ? null : x.Nama)" MaxItems="80" />
                    </div>
                </div>
                <div class="flex-1">
                    <MudTextField T="string" Label="Metode Bayar" ReadOnly="true" tabindex="-1" Value="pembelian.MetodeBayar" />
                    <MudTextField T="string" Label="Status" ReadOnly="true" tabindex="-1" Value="pembelian.Status" />
                </div>
            </MudStack>
        </MudForm>
        <MudDataGrid Items="pembelian.PembelianDetail" Elevation="2" Class="my-3" Dense="true" Bordered="true" ShowColumnOptions="false">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Bahan yang dibeli</MudText>
                <MudSpacer />
                <MudAutocomplete Class="mt-n3" T="BahanSatuan" @ref="inputBahanSatuan" Dense="true" Placeholder="Cari bahan..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" CoerceText="true" SearchFunc="@(async e => await CariBahanSatuan(e))" ValueChanged="@(e => PilihBahanSatuan(e))" ToStringFunc="@(x => x is null ? null : string.IsNullOrEmpty(x.Ukuran) ? $"{x.Bahan!.Nama} ({x.Nama})" : $"{x.Bahan!.Nama} ({x.Nama} — {x.Ukuran})")" MaxItems="80" />
            </ToolBarContent>
            <Columns>
                <Column T="PembelianDetail" Field="BahanSatuan" Title="Nama Bahan" SortBy="@(e => e.BahanSatuan!.Nama)">
                    <CellTemplate>
                        @context.Item.BahanSatuan!.Bahan!.Nama
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" Field="Harga" Title="Harga Beli" HeaderStyle="width:1px">
                    <CellTemplate>
                        <MudNumericField T="int" Class="mt-n1" Immediate="true" Value="context.Item.Harga" ValueChanged="@(e => {context.Item.Harga = e; Hitung();})" Min="1" Max="1000000000" HideSpinButtons="true" Format="n0" tabindex="-1" />
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" Field="BahanSatuan" Title="Stok Awal" HeaderStyle="width:1px" SortBy="@(e => e.BahanSatuan!.Bahan!.Stok)" CellStyle="text-align:center">
                    <CellTemplate>
                        @context.Item.BahanSatuan!.Bahan!.Stok.ToString("g0") @context.Item.BahanSatuan!.Bahan!.SatuanProduksi
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" Field="Jumlah" HeaderStyle="width:200px">
                    <CellTemplate>
                        <MudNumericField T="decimal" Class="mt-n1" Immediate="true" Value="context.Item.Jumlah" Adornment="Adornment.End" AdornmentText="@(string.IsNullOrEmpty(context.Item.BahanSatuan!.Ukuran) ? context.Item.BahanSatuan!.Nama : $"{context.Item.BahanSatuan!.Nama} ({context.Item.BahanSatuan!.Ukuran})")" ValueChanged="@(e => {context.Item.Jumlah = decimal.Round(e, 2); Hitung();})" Min="@(context.Item.MinJumlah == 0 ? 0.01m : context.Item.MinJumlah)" Max="9999999" HideSpinButtons="true" Format="g0" />
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" Field="StokAkhir" Title="Stok Akhir" HeaderStyle="width:1px" CellStyle="text-align:center">
                    <CellTemplate>
                        @context.Item.StokAkhir.ToString("g0") @context.Item.BahanSatuan!.Bahan!.SatuanProduksi
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" Field="Total" HeaderStyle="width:1px" CellStyle="text-align:right">
                    <CellTemplate>
                        @context.Item.Total.ToString("n0")
                    </CellTemplate>
                </Column>
                <Column T="PembelianDetail" HeaderStyle="width:1px" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(async e => await DeleteDetail(context.Item))" tabindex="-1" />
                    </CellTemplate>
                </Column>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="PembelianDetail" RowsPerPageString="Jumlah baris per halaman" InfoFormat="Menampilkan {first_item} - {last_item} dari {all_items} bahan" />
            </PagerContent>
        </MudDataGrid>
        <MudStack Row="true">
            <div class="flex-1">
                <MudNumericField Label="Subtotal" Adornment="Adornment.Start" AdornmentText="Rp" ReadOnly="true" tabindex="-1" Value="@pembelian.Subtotal" HideSpinButtons="true" Format="n0" />
                <div class="wp-30">
                    <MudNumericField T="int" Label="PPN" Adornment="Adornment.End" AdornmentText="%" Immediate="true" Value="pembelian.PPN" ValueChanged="@(e => {pembelian.PPN = e; Hitung();})" HideSpinButtons="true" Min="0" Max="100" Format="g0" />
                </div>
                <MudNumericField Label="Grand Total" Adornment="Adornment.Start" AdornmentText="Rp" ReadOnly="true" tabindex="-1" Value="pembelian.GrandTotal" HideSpinButtons="true" Format="n0" />
            </div>
            <div class="flex-1">
                @if (!baru)
                {
                    <MudNumericField Label="Terbayar" Adornment="Adornment.Start" AdornmentText="Rp" ReadOnly="true" tabindex="-1" Value="@pembelian.Terbayar" HideSpinButtons="true" Format="n0" />
                }
                else
                {
                    <MudNumericField T="int" Label="Uang Muka" Adornment="Adornment.Start" AdornmentText="Rp" Immediate="true" Value="transaksiPembelian.Nominal" ValueChanged="@(e => {transaksiPembelian.Nominal = e; Hitung();})" HideSpinButtons="true" Min="0" Max="1000000000" Format="n0" />
                }
                <MudNumericField Label="@transaksiPembelian.BalanceLabel" Adornment="Adornment.Start" AdornmentText="Rp" ReadOnly="true" tabindex="-1" Value="@transaksiPembelian.Balance" HideSpinButtons="true" Format="n0" />
            </div>
            <div class="flex-4">
                <MudTextField T="string" MaxLength="200" Label="Keterangan" @bind-Value="pembelian.Keterangan" />
                @if (pembelian.MetodeBayar == "Kredit")
                {
                    <MudStack Row="true" Class="wp-35">
                        <div class="flex-5">
                            <MudDatePicker PickerVariant="PickerVariant.Dialog" Date="pembelian.JatuhTempo" MinDate="@(pembelian.InputTanggal?.AddDays(1))" MaxDate="@(pembelian.InputTanggal?.AddDays(1000))" DateChanged="@(e => HitungJatuhTempo(e))" Label="Jatuh Tempo" DateFormat="dd/MM/yyyy" />
                        </div>
                        <div class="flex-3">
                            <MudNumericField T="int" Adornment="Adornment.End" AdornmentText="Hari" Immediate="true" Value="pembelian.HariJatuhTempo" ValueChanged="@(e => {pembelian.HariJatuhTempo = e; pembelian.JatuhTempo = pembelian.InputTanggal?.AddDays(pembelian.HariJatuhTempo);})" HideSpinButtons="true" Min="1" Max="1000" Format="g0" />
                        </div>
                    </MudStack>
                }
            </div>
        </MudStack>
        <MudStack Row="true" Class="mt-4">
            <div>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Help" @onmouseenter="@(() => popupTerbuka = true)" @onmouseleave="@(() => popupTerbuka = false)" />
                <MudPopover Open="@popupTerbuka" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomLeft" Fixed="true" Class="px-4">
                    <MudStack Spacing="0" Class="pb-2">
                        <MudText Typo="Typo.button" Class="pt-2">Supplier :</MudText>
                        <div>▪ Tidak boleh kosong</div>
                        <MudText Typo="Typo.button" Class="pt-2">Bahan :</MudText>
                        <div>▪ Jumlah bahan tidak boleh kurang dari yang sudah diretur</div>
                        <div>▪ Bahan yang sudah diretur tidak bisa dihapus</div>
                    </MudStack>
                </MudPopover>
            </div>
            @if (result is null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" @onclick="@(async e => await Refresh())" Style="cursor: pointer;">@pesan</MudText>
            }
            <MudSpacer />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@warna" OnClick="(async () => await Save())" Disabled="@(result is null || !pembelian.PembelianDetail!.Any())">Simpan</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Dark" OnClick="@(e => To.NavigateTo("/pembelian"))">Batal</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (baru && (pembelian.Supplier is not null || transaksiPembelian.Nominal > 0 || pembelian.PembelianDetail!.Any()))
    {
        <NavigationLock ConfirmExternalNavigation="true" />
    }
}